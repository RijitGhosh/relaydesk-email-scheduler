# ---------- Core ----------
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
# Min 16 chars. Also derives the AES key that encrypts SMTP passwords + Slack tokens at rest.
SESSION_SECRET=change-me-to-a-long-random-string-32chars+
SESSION_TTL_DAYS=7
# Optional comma-separated emails allowed to open /admin/queues (empty = any signed-in user)
ADMIN_EMAILS=

# ---------- Infrastructure (matches docker-compose.yml) ----------
DATABASE_URL=postgresql://relaydesk:relaydesk@localhost:5432/relaydesk
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=relaydesk-emails

# ---------- Google OAuth (required for login) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ---------- Slack OAuth (required for rate-limit alerts) ----------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback

# ---------- Ethereal SMTP (optional) ----------
# Leave blank: RelayDesk auto-creates a real Ethereal account per sender via nodemailer.createTestAccount().
# Fill all four to use one fixed account for the default sender instead.
ETHEREAL_HOST=
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=

# ---------- Queue behaviour ----------
WORKER_CONCURRENCY=5
MIN_SEND_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MAX_RECIPIENTS_PER_REQUEST=5000
WORKER_HEALTH_PORT=4001
LOG_LEVEL=info
